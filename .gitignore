# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── DEPENDENCIES ──────────────────────────────────────────────────────
# Removed leading slashes so it targets node_modules in both frontend/ and backend/
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── TESTING & DEBUG ───────────────────────────────────────────────────
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── FRONTEND (NEXT.JS) ────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/.vercel/

# ── PRODUCTION BUILDS ─────────────────────────────────────────────────
build/
backend/dist/

# ── ENVIRONMENT VARIABLES (CRITICAL SECURITY) ─────────────────────────
# This keeps your Replicate Token and DB strings safe across all folders
.env
.env.*
*.env

# ── MISC & TYPESCRIPT ─────────────────────────────────────────────────
.DS_Store
*.pem
*.tsbuildinfo
backend/.wwebjs_auth
backend/.wwebjs_cache
# Keep next-env.d.ts only if you want next to auto-regenerate it without tracking
# frontend/next-env.d.ts